{
  "name": "@wengine-ai/pi-session-handoff",
  "version": "0.1.0",
  "type": "module",
  "description": "Hand a self-contained task to another local pi session (GUI or TUI) — recipient keeps its own project, model and permissions; busy targets queue instead of being interrupted.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "session",
    "handoff",
    "agent"
  ],
  "license": "MIT",
  "files": [
    "index.mjs",
    "transport.mjs",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoliu10/pi-desktop.git",
    "directory": "extensions/session-handoff"
  },
  "homepage": "https://github.com/xiaoliu10/pi-desktop/tree/main/extensions/session-handoff",
  "bugs": {
    "url": "https://github.com/xiaoliu10/pi-desktop/issues"
  }
}
